#!/usr/bin/env bash
# with-secret (--env VAR | --stdin) [--title T] [--message M] [--placeholder P] [--] CMD...
#
# Asks for one secret through secret-prompt and hands it to CMD alone: as the
# environment variable VAR of that process, or on its stdin followed by a
# newline. Never echoed, never in argv. See docs/design.md.

set -euo pipefail

# The panel next to this script when installed together, else the one on PATH.
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
panel=$here/secret-prompt
if [[ ! -x $panel ]] && ! panel=$(command -v secret-prompt); then
  echo "with-secret: secret-prompt is neither next to this script nor on PATH" >&2
  exit 127
fi

# The command as a person would type it: plain words bare, anything else in
# single quotes. Only for showing in the panel, never for running.
display() {
  local out="" arg q="'"
  for arg in "$@"; do
    if [[ $arg =~ ^[A-Za-z0-9_./:=@%+,#-]+$ ]]; then
      out+="$arg "
    elif [[ $arg != *"$q"* ]]; then
      out+="$q$arg$q "
    elif [[ $arg != *[\$\`\"\\]* ]]; then
      out+="\"$arg\" "
    else
      out+="$q${arg//$q/$q\\$q$q}$q "
    fi
  done
  printf '%s' "${out% }"
}

usage() {
  echo "usage: with-secret (--env VAR | --stdin) [--title T] [--message M] [--placeholder P] [--] CMD..." >&2
  exit 2
}

mode="" var=""
prompt=(--title "Secret required" --icon key.fill --placeholder Secret)
while [[ $# -gt 0 ]]; do
  case $1 in
    --env)
      [[ $# -ge 2 ]] || usage
      mode=env var=$2
      shift 2
      ;;
    --stdin) mode=stdin; shift ;;
    --title | --message | --placeholder)
      [[ $# -ge 2 ]] || usage
      prompt+=("$1" "$2")
      shift 2
      ;;
    --) shift; break ;;
    -*) echo "with-secret: unknown option $1" >&2; usage ;;
    *) break ;;
  esac
done
[[ -n $mode && $# -gt 0 ]] || usage
if [[ $mode == env && ! $var =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
  echo "with-secret: --env needs a variable name, got '$var'" >&2
  exit 2
fi

shown=$(display "$@")
status=0
secret=$("$panel" "${prompt[@]}" --command "$shown") || status=$?
if ((status == 1)); then
  echo "with-secret: cancelled, $1 was not run" >&2
  exit 1
elif ((status != 0)); then
  echo "with-secret: secret-prompt failed with exit $status, $1 was not run" >&2
  exit "$status"
fi

if [[ $mode == env ]]; then
  export "$var=$secret"
  [[ $var == secret ]] || unset secret
  exec -- "$@"
fi
# A pipe from the printf builtin: no argv, and no here-string temp file on disk.
printf '%s\n' "$secret" | "$@"
